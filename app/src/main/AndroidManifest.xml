<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="org.autojs.permission.PLUGIN" />

    <!--
        F.5: the gallery reads host appearance through the official settings Provider and hands scripts to the host.
        P9.2 / D42: the designer binds the TypeScript Engine parser service (PLUGIN permission) to read TSX projects.
    -->
    <queries>
        <package android:name="org.autojs.autojs6" />
        <package android:name="io.github.supermonster003.autojs6.plugin.typescript" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_icon_studio_application"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ThreeBlockCompose"
        android:roundIcon="@mipmap/ic_icon_studio_application">

        <meta-data
            android:name="org.autojs.plugin.WAKE_ACTIVITY"
            android:value=".WakeActivity" />
        <meta-data
            android:name="org.autojs.plugin.info.AUTHOR"
            android:value="@string/plugin_author" />
        <!--
            In-process renderer entry (roadmap D10 / D23): the host instantiates this class on a class loader
            whose parent is the host class loader. The class lands with the roadmap P0.2 spike renderer.
        -->
        <meta-data
            android:name="org.autojs.plugin.compose.RENDERER_FACTORY"
            android:value="io.github.supermonster003.autojs6.plugin.three.block.compose.renderer.ComposeUiRendererFactoryImpl" />
        <!-- F.4: first integrated host build supporting the V2 component catalog. -->
        <meta-data
            android:name="requiresHostVersion"
            android:value="5322" />

        <activity
            android:name=".WakeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:permission="org.autojs.permission.PLUGIN"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="org.autojs.plugin.action.WAKE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Plugin center discovery (roadmap D23): INFO only, no Binder capability service, same shape as the ImGui plugin. -->
        <service
            android:name=".ThreeBlockComposeInfoService"
            android:enabled="true"
            android:exported="true"
            android:permission="org.autojs.permission.PLUGIN">
            <intent-filter>
                <action android:name="org.autojs.plugin.INFO" />
                <category android:name="three-block-compose" />
            </intent-filter>
        </service>

        <!--
            F.5 component gallery (roadmap D8 as revised on 2026-10-08): the plugin's own screens run in this
            process. The launcher entry is one of four fixed aliases that persist the user's icon choice as
            component enabled state (icon specification section 1); only the automatic alias is enabled by default.
        -->
        <!-- Roadmap P8.3 / D38: the designer home is the launcher target; the editor keeps its state across rotation. -->
        <activity
            android:name=".designer.ui.DesignerHomeActivity"
            android:configChanges="uiMode|locale|layoutDirection"
            android:exported="false" />
        <!--
            Roadmap P8.4 / D39: the editor also opens script documents handed over by the host editor or a file
            manager (content or file Uri) and writes them back through the same Uri when the grant allows it.
            P9.2: `.tsx` documents (text/typescript) open as TSX projects.
        -->
        <activity
            android:name=".designer.ui.DesignerActivity"
            android:configChanges="uiMode|locale|layoutDirection|orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.EDIT" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/x-javascript" />
                <data android:mimeType="text/javascript" />
                <data android:mimeType="text/typescript" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity
            android:name=".app.GalleryActivity"
            android:configChanges="uiMode|locale|layoutDirection"
            android:exported="false" />
        <activity-alias
            android:name=".launcher.AdaptiveLightIconAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_system_light"
            android:roundIcon="@mipmap/ic_launcher_system_light"
            android:targetActivity=".designer.ui.DesignerHomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.AdaptiveDarkIconAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_system"
            android:roundIcon="@mipmap/ic_launcher_system"
            android:targetActivity=".designer.ui.DesignerHomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.AdaptiveAutoIconAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_system_auto"
            android:roundIcon="@mipmap/ic_launcher_system_auto"
            android:targetActivity=".designer.ui.DesignerHomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.TransparentIconAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".designer.ui.DesignerHomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".app.SettingsActivity"
            android:configChanges="uiMode|locale|layoutDirection"
            android:exported="false" />
        <receiver
            android:name=".app.LauncherIconUpdateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            The packaged AndroidX runtime (roadmap D32) would merge the androidx.startup provider with the emoji,
            process-lifecycle and profile initializers. None is needed by the plugin's screens, so it stays removed.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />
        <!--
            Roadmap P8.4 / D39: the only provider. It exposes the designer's project files to the host (open in
            the host editor, import into the host script directory) through per-Intent Uri grants; nothing is
            exported without a grant and no other directory is reachable.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.designer"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/designer_paths" />
        </provider>

    </application>

</manifest>
