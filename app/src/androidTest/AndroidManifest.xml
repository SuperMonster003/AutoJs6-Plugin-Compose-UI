<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Package visibility for the discovery queries of ComposeUiPluginContractTest on API 30+. -->
    <queries>
        <package android:name="io.github.supermonster003.autojs6.plugin.compose.ui" />
    </queries>
    <application>
        <!-- Test code shares the target APK's Kotlin in instrumentation, not in a standalone test-app process. -->
        <provider android:name="androidx.startup.InitializationProvider" tools:node="remove" />
    </application>
</manifest>
